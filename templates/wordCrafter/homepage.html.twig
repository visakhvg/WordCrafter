<!DOCTYPE html>

<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Word Crafter</title>
        <style>
            body {
                font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f0f2f5;
                color: #333;
                margin: 0;
                padding: 0;
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
            }

            .container {
                display: flex;
                flex-direction: column;
                gap: 40px;
                width: 90%;
                max-width: 1000px;
                padding: 20px;
            }

            @media (min-width: 768px) {
                .container {
                    flex-direction: row;
                    gap: 60px;
                    padding: 40px;
                }
            }

            .section {
                background-color: white;
                padding: 30px;
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
                flex-grow: 1;
            }

            .section-header {
                text-align: center;
                margin-bottom: 20px;
                color: #4a5568;
            }

            h1 {
                font-size: 2.5em;
                color: #2c3e50;
                text-align: center;
                margin-bottom: 0.5em;
            }

            p {
                text-align: center;
                font-size: 1.1em;
                color: #7f8c8d;
                margin-bottom: 2em;
            }

            /* Form Styles */
            .form-container {
                text-align: center;
            }

            .form-container label {
                display: block;
                margin-bottom: 10px;
                font-weight: bold;
                color: #34495e;
            }

            .form-container input[type="text"] {
                width: 80%;
                max-width: 300px;
                padding: 12px;
                border: 2px solid #ddd;
                border-radius: 8px;
                transition: all 0.3s ease;
            }

            .form-container input[type="text"]:focus {
                outline: none;
                border-color: #3498db;
                box-shadow: 0 0 8px rgba(52, 152, 219, 0.2);
            }

            .form-container button {
                background-color: #2ecc71;
                color: white;
                padding: 12px 25px;
                border: none;
                border-radius: 8px;
                font-size: 1em;
                font-weight: bold;
                cursor: pointer;
                margin-top: 15px;
                transition: all 0.3s ease;
            }

            .form-container button:hover {
                background-color: #27ae60;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(46, 204, 113, 0.3);
            }

            /* Leaderboard Styles */
            .leaderboard {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .leaderboard-title {
                text-align: center;
                font-size: 1.5em;
                color: #34495e;
                margin-bottom: 20px;
                position: relative;
            }

            .leaderboard-title::after {
                content: "";
                display: block;
                width: 50px;
                height: 3px;
                background-color: #3498db;
                margin: 10px auto 0;
                border-radius: 2px;
            }

            .leaderboard li {
                background-color: #ecf0f1;
                padding: 15px;
                border-radius: 10px;
                margin-bottom: 15px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 1.1em;
                transition: all 0.3s ease;
            }

            .leaderboard li:hover {
                background-color: #e0e6e9;
                transform: translateX(5px);
            }

            .leaderboard li .rank {
                font-weight: bold;
                color: #3498db;
                width: 30px;
            }

            .leaderboard li .word {
                flex-grow: 1;
                margin-left: 10px;
            }

            .leaderboard li .score {
                font-weight: bold;
                color: #e74c3c;
            }

            /* Flash Messages */
            .alert {
                padding: 15px;
                border-radius: 8px;
                margin-bottom: 15px;
                text-align: center;
                font-weight: bold;
                color: white;
            }

            .alert-danger {
                background-color: #e74c3c;
            }
        </style>
    </head>
    <body>
        {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
        <h1>Welcome to the World of Word Crafter!</h1>
        <p>
            Enter your name to start a new game or check out the top leads who
            tried.
        </p>

        <div class="container">
            <!-- Player Name and Start Game Section -->
            <div class="section form-container">
                <h2 class="section-header">Start a New Game</h2>
                {% for message in app.flashes('error') %}
                <div class="alert alert-danger">{{ message }}</div>
                {% endfor %}
                <form action="{{ path('start_game') }}" method="post">
                    <label for="player_name">Your Name:</label>
                    <input
                        type="text"
                        id="player_name"
                        name="player_name"
                        required
                        autocomplete="off"
                    />
                    <button type="submit">Start Game</button>
                </form>
            </div>

            <!-- High Scores Leaderboard Section -->
            <div class="section">
                <h2 class="leaderboard-title">Top 10 HighScores</h2>
                {% if highscores is empty %}
                <p style="text-align: center; color: #7f8c8d">
                    No highscores yet. Be the first!
                </p>
                {% else %}
                <ol class="leaderboard">
                    {% for highscore in highscores %}
                    <li>
                        <span class="rank">{{ loop.index }}.</span>
                        <span class="word"
                            >{{ highscore.username }}
                            <!-- <span class="">
                                {{ highscore.submittedWords|join('<br />')|raw }}
                            </span> -->
                        </span>
                        <span class="score">{{ highscore.score }}</span>
                    </li>
                    {% endfor %}
                </ol>
                {% endif %}
            </div>
            <div class="section">
                <h2 class="leaderboard-title">Top 10 Most Repeated Words</h2>
                {% if mostRepeatedWords is empty %}
                <p style="text-align: center; color: #7f8c8d">
                    No words submitted yet. Be the first!
                </p>
                {% else %}
                <ol class="leaderboard">
                    {% for word, count in mostRepeatedWords %}
                    <li>
                        <span class="rank">{{ loop.index }}.</span>
                        <span class="word">{{ word }}</span>
                        <span class="score">{{ count }}</span>
                    </li>
                    {% endfor %}
                </ol>
                {% endif %}
            </div>
        </div>
    </body>
</html>
